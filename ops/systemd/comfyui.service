[Unit]
Description=ComfyUI worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ComfyUI
# CPU-only default. Remove --cpu on a GPU worker.
# ComfyUI has no authentication. Restrict port 8188 with a firewall or VPN.
ExecStart=%h/ComfyUI/venv/bin/python %h/ComfyUI/main.py --listen 0.0.0.0 --port 8188 --cpu
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
