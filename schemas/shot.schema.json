      "type": "string"
    },
    "refs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Refs",
      "type": "object"
    },
    "render": {
      "$ref": "#/$defs/RenderDefaults"
    },
    "prompt": {
      "$ref": "#/$defs/Prompt"
    },
