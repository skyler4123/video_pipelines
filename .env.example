# Copy to .env and export before use:
#   cp .env.example .env
#   set -a; source .env; set +a

# Optional: external media root. If unset, assets stay under projects/<id>/assets.
MEDIA_ROOT=

# Optional: model root used by registry/models.yaml.
MODELS_DIR=

# ComfyUI checkout and virtualenv used by bin/comfy.
COMFYUI_HOME=$HOME/ComfyUI
COMFYUI_VENV=$HOME/ComfyUI/venv
COMFYUI_LISTEN=0.0.0.0
COMFYUI_PORT=8188

# ComfyUI API endpoint used by the runner.
COMFYUI_URL=http://127.0.0.1:8188

# ComfyUI execution limits.
COMFYUI_TIMEOUT=1800
COMFYUI_POLL_INTERVAL=2
