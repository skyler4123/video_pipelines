* text=auto eol=lf

*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Small tracked inputs. Install Git LFS before adding large refs,
# or use an external asset store and keep only hashes in manifests.
projects/*/refs/**/*.png filter=lfs diff=lfs merge=lfs -text
